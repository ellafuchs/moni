# Copy this file to .env and fill in your own values.
# .env is gitignored and is the ONLY place secrets live — never put them in files/config.json.

# LLM key for letter extraction — only the one matching model_provider in files/config.json is used.
#   model_provider "openai"       -> OPENAI_API_KEY (https://platform.openai.com/api-keys, paid)
#   model_provider "google_genai" -> GEMINI_API_KEY (https://aistudio.google.com/apikey, free tier)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gmail address the summary emails are sent from.
MONI_SENDER=

# Gmail API access (Google Cloud Console, https://console.cloud.google.com):
#   1. create a project and enable the "Gmail API"
#   2. OAuth consent screen: External, Testing; add MONI_SENDER as a test user
#   3. Credentials -> Create OAuth client ID -> "Desktop app"; copy id + secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by `uv run python bot/gmail_auth.py` (opens Google's consent page once).
GOOGLE_REFRESH_TOKEN=
